{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-hq.local/contracts/task-pack.schema.json",
  "title": "TaskPack",
  "type": "object",
  "required": [
    "task_id",
    "goal",
    "scope",
    "constraints",
    "ui_work_type",
    "design_phase_required",
    "layout_exploration_required",
    "visual_concepts_required",
    "browser_fidelity_review_required",
    "must_read",
    "acceptance_criteria",
    "verification_commands",
    "docs_required",
    "approval_required"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z0-9-]+$"
    },
    "goal": {
      "type": "string"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ui_work_type": {
      "type": "string",
      "enum": [
        "non-ui",
        "ui-narrow-edit",
        "ui-surface-refresh",
        "ui-new-screen",
        "ui-foundation"
      ]
    },
    "design_phase_required": {
      "type": "boolean"
    },
    "layout_exploration_required": {
      "type": "boolean"
    },
    "visual_concepts_required": {
      "type": "boolean"
    },
    "browser_fidelity_review_required": {
      "type": "boolean"
    },
    "primary_screen": {
      "type": "string"
    },
    "layout_thesis": {
      "type": "string"
    },
    "visual_thesis": {
      "type": "string"
    },
    "must_read": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "allOf": [
        {
          "contains": {
            "const": "docs/design/art-direction.kr.md"
          }
        },
        {
          "contains": {
            "const": "docs/design/ui-principles.kr.md"
          }
        },
        {
          "contains": {
            "const": "docs/design/browser-review.kr.md"
          }
        },
        {
          "contains": {
            "const": "docs/prompting/prompt-context.kr.md"
          }
        }
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "docs_required": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "allOf": [
        {
          "contains": {
            "const": "docs/design/art-direction.kr.md"
          }
        },
        {
          "contains": {
            "const": "docs/design/ui-principles.kr.md"
          }
        },
        {
          "contains": {
            "const": "docs/design/browser-review.kr.md"
          }
        },
        {
          "contains": {
            "const": "docs/prompting/prompt-context.kr.md"
          }
        }
      ]
    },
    "approval_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
